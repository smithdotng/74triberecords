# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/tribe74?retryWrites=true&w=majority"

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_API_KEY=""

# Optional: Sign in with Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that get admin access (manage shows, sync episodes)
ADMIN_EMAILS="stanleyebosie@gmail.com"

# Secret for the scheduled episode sync endpoint: GET /api/cron/sync with header Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-another-random-string"

# Optional: import reels automatically from your Instagram professional account.
# Instagram API with Instagram Login → long-lived access token (refreshed automatically by the app).
INSTAGRAM_ACCESS_TOKEN=""

# Studio contact details shown on the About and Book pages
NEXT_PUBLIC_STUDIO_EMAIL=""
NEXT_PUBLIC_STUDIO_PHONE=""
NEXT_PUBLIC_STUDIO_ADDRESS=""

# Optional: booking emails (e.g. Hostinger: smtp.hostinger.com, port 465)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
# Where new booking requests are sent (defaults to the first ADMIN_EMAILS address)
BOOKINGS_EMAIL=""
